<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DocBookKeeping.ViewModels"
             x:Class="DocBookKeeping.Views.CategoryView"
             x:DataType="vm:KategoriViewModel">
  <ScrollViewer>
    <StackPanel Spacing="24" Margin="0,0,0,24">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="Kategori" FontSize="30" FontWeight="Bold" Foreground="#111827" />
          <TextBlock Text="Kelola kategori barang dan jasa" FontSize="14" Foreground="#6B7280" />
        </StackPanel>
        <Button Grid.Column="1" Content="⟳  Refresh" Command="{Binding LoadKategorisCommand}"
                Padding="18,10" Background="#4F46E5" Foreground="White"
                BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" />
      </Grid>

      <Border Background="White" CornerRadius="14" Padding="20" BoxShadow="0 1 3 0 #0A000000" Width="260" HorizontalAlignment="Left">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="42" Height="42" CornerRadius="10" Background="#EEF2FF">
            <TextBlock Text="◆" FontSize="16" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Total Kategori" FontSize="12.5" Foreground="#6B7280" />
            <TextBlock Text="{Binding JumlahKategori}" FontSize="21" FontWeight="Bold" Foreground="#111827" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Background="White" CornerRadius="14" Padding="22" BoxShadow="0 1 3 0 #0A000000">
        <StackPanel Spacing="14">
          <TextBlock Text="Form Kategori" FontWeight="SemiBold" FontSize="15" Foreground="#111827" />
          <Rectangle Height="1" Fill="#F3F4F6" />

          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox Text="{Binding FormNamaKategori}" Width="240" PlaceholderText="Nama kategori" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Tambah" Command="{Binding AddKategoriCommand}"
                    Background="#16A34A" Foreground="White" BorderThickness="0" Padding="18,10" CornerRadius="8" />
            <Button Content="Simpan Perubahan" Command="{Binding UpdateKategoriCommand}"
                    Background="#4F46E5" Foreground="White" BorderThickness="0" Padding="18,10" CornerRadius="8" />
            <Button Content="Hapus" Command="{Binding DeleteKategoriCommand}"
                    Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Padding="18,10" CornerRadius="8" />
            <Button Content="Batal" Command="{Binding ClearFormCommand}"
                    Background="Transparent" Foreground="#6B7280" BorderThickness="1" BorderBrush="#E5E7EB"
                    Padding="18,10" CornerRadius="8" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Border Background="White" CornerRadius="14" Padding="22" BoxShadow="0 1 3 0 #0A000000">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="◆" FontSize="14" Foreground="#4F46E5" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Daftar Kategori" FontWeight="SemiBold" Foreground="#111827" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" Text="{Binding SearchText}" PlaceholderText="Cari kategori..." Width="220" />
          </Grid>
          <Rectangle Height="1" Fill="#F3F4F6" />
          <DataGrid ItemsSource="{Binding Kategoris}" SelectedItem="{Binding SelectedKategori}"
                    AutoGenerateColumns="False" GridLinesVisibility="Horizontal" IsReadOnly="True" MinHeight="350">
            <DataGrid.Styles>
              <Style Selector="DataGridCell TextBlock"><Setter Property="Foreground" Value="#111827" /></Style>
              <Style Selector="DataGridColumnHeader">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#6B7280" />
              </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTextColumn Header="No" Binding="{Binding No}" Width="60" />
              <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>