<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DocBookKeeping.ViewModels"
             x:Class="DocBookKeeping.Views.BarangKeluarView"
             x:DataType="vm:BarangKeluarViewModel">
  <ScrollViewer>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="20" Margin="0,0,0,20">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="Barang Keluar" FontSize="28" FontWeight="Bold" Foreground="#111827" />
          <TextBlock Text="Catat penjualan, pemakaian produksi, konsumsi sendiri, atau kerusakan" FontSize="13" Foreground="#6B7280" />
        </StackPanel>
        <Button Grid.Column="1" Content="+ Tambah" Command="{Binding OpenAddFormCommand}"
                Padding="18,10" Margin="0,0,10,0" Background="#DC2626" Foreground="White"
                BorderThickness="0" CornerRadius="6" />
        <Button Grid.Column="2" Content="Refresh" Command="{Binding LoadTransCommand}"
                Padding="18,10" Background="#4F46E5" Foreground="White"
                BorderThickness="0" CornerRadius="6" />
      </Grid>

      <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="8" IsVisible="{Binding IsFormVisible}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding FormModeLabel}" FontWeight="SemiBold" FontSize="13" Foreground="#4F46E5" />

          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
              <ComboBox PlaceholderText="Pilih Barang" ItemsSource="{Binding BarangOptions}"
                        SelectedItem="{Binding FormBarang}" Width="180">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding NamaBarang}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <ComboBox PlaceholderText="Tujuan Keluar" ItemsSource="{Binding TujuanKeluarOptions}"
                        SelectedItem="{Binding FormTujuanKeluar}" Width="150" />

              <TextBox PlaceholderText="Jumlah" Text="{Binding FormJumlah}" Width="90" />
              <TextBox PlaceholderText="Harga Satuan" Text="{Binding FormHargaSatuan}" Width="130" />
              <TextBox PlaceholderText="Nilai (Total)" Text="{Binding FormNilai}" Width="130" />
              <TextBox PlaceholderText="Keterangan" Text="{Binding FormKeterangan}" Width="200" />
            </StackPanel>
          </WrapPanel>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Simpan" Command="{Binding AddTransCommand}"
                    Background="#16A34A" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6" />
            <Button Content="Batal" Command="{Binding ClearFormCommand}"
                    Background="Transparent" Foreground="#6B7280" BorderThickness="1" Padding="15,10" CornerRadius="6" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- BREAKDOWN HPP FIFO -->
      <Border Grid.Row="2" Background="#EEF2FF" Padding="15" CornerRadius="8"
              IsVisible="{Binding LastHppBreakdown.Count}">
        <StackPanel Spacing="8">
          <TextBlock Text="Rincian HPP (diambil dari batch FIFO)" FontWeight="SemiBold" Foreground="#4F46E5" FontSize="13" />
          <ItemsControl ItemsSource="{Binding LastHppBreakdown}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="12" Foreground="#374151">
                  <Run Text="Batch #" /><Run Text="{Binding IdBatch}" />
                  <Run Text=" — " /><Run Text="{Binding JumlahDiambil}" /><Run Text=" unit × Rp " />
                  <Run Text="{Binding HargaPokokSatuan, StringFormat={}{0:N0}}" />
                  <Run Text=" = Rp " /><Run Text="{Binding SubtotalNilai, StringFormat={}{0:N0}}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding LastHppTotal, StringFormat={}Total HPP: Rp {0:N0}}"
                     FontWeight="Bold" Foreground="#4F46E5" FontSize="14" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Background="White" Padding="15" CornerRadius="8">
        <TextBox PlaceholderText="Cari nama barang..." Text="{Binding SearchText}" Width="300" HorizontalAlignment="Left" />
      </Border>

      <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />

      <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="15" MinHeight="400">
        <DataGrid ItemsSource="{Binding TransList}" SelectedItem="{Binding SelectedTrans}"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal" IsReadOnly="True" MinHeight="350">
          <DataGrid.Styles>
            <Style Selector="DataGridCell TextBlock"><Setter Property="Foreground" Value="#111827" /></Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTextColumn Header="No" Binding="{Binding No}" Width="40" />
            <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalInput}" Width="90" />
            <DataGridTextColumn Header="Barang" Binding="{Binding IdBarangNavigation.NamaBarang}" Width="150" />
            <DataGridTextColumn Header="Tujuan" Binding="{Binding TujuanKeluar}" Width="110" />
            <DataGridTextColumn Header="Jml" Binding="{Binding Jumlah}" Width="45" />
            <DataGridTextColumn Header="Nilai" Binding="{Binding Nilai, StringFormat={}{0:N0}}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

    </Grid>
  </ScrollViewer>
</UserControl>
