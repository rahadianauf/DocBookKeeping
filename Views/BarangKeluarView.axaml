<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DocBookKeeping.ViewModels"
             x:Class="DocBookKeeping.Views.BarangKeluarView"
             x:DataType="vm:BarangKeluarViewModel">
  <ScrollViewer>
    <StackPanel Spacing="24" Margin="0,0,0,24">

      <!-- HEADER -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="Barang Keluar" FontSize="30" FontWeight="Bold" Foreground="#111827" />
          <TextBlock Text="Penjualan, pemakaian produksi, konsumsi sendiri, atau kerusakan" FontSize="14" Foreground="#6B7280" />
        </StackPanel>

        <Button Grid.Column="1" Content="＋  Tambah" Command="{Binding OpenAddFormCommand}"
                Padding="18,10" Margin="0,0,10,0" Background="#DC2626" Foreground="White"
                BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" />

        <Button Grid.Column="2" Content="⟳  Refresh" Command="{Binding LoadTransCommand}"
                Padding="18,10" Background="#4F46E5" Foreground="White"
                BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" />
      </Grid>

      <!-- KPI RINGKAS -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

        <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" BoxShadow="0 1 3 0 #0A000000">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="10" Background="#FEE2E2">
              <TextBlock Text="⬆" FontSize="15" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Jumlah Transaksi" FontSize="12.5" Foreground="#6B7280" />
              <TextBlock Text="{Binding JumlahTransaksi}" FontSize="21" FontWeight="Bold" Foreground="#111827" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="#DC2626" CornerRadius="14" Padding="20">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="10" Background="#EF4444">
              <TextBlock Text="Rp" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Total Nilai Keluar" FontSize="12.5" Foreground="#FEE2E2" />
              <TextBlock Text="{Binding TotalNilai, StringFormat={}Rp {0:N0}}" FontSize="21" FontWeight="Bold" Foreground="White" />
            </StackPanel>
          </Grid>
        </Border>

      </Grid>

      <!-- FORM TAMBAH -->
      <Border Background="White" CornerRadius="14" Padding="22" BoxShadow="0 1 3 0 #0A000000"
              IsVisible="{Binding IsFormVisible}">
        <StackPanel Spacing="14">

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding FormModeLabel}" FontWeight="SemiBold" FontSize="15" Foreground="#111827" />
            <Button Grid.Column="1" Content="✕" Command="{Binding ClearFormCommand}"
                    Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="8,4" FontSize="14" />
          </Grid>

          <Rectangle Height="1" Fill="#F3F4F6" />

          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">

              <StackPanel Spacing="4">
                <TextBlock Text="Tanggal Transaksi" FontSize="11" Foreground="#6B7280" />
                <DatePicker SelectedDate="{Binding FormTanggalTransaksi}" Width="160" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Barang" FontSize="11" Foreground="#6B7280" />
                <ComboBox ItemsSource="{Binding BarangOptions}" SelectedItem="{Binding FormBarang}" Width="180">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding NamaBarang}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Tujuan Keluar" FontSize="11" Foreground="#6B7280" />
                <ComboBox ItemsSource="{Binding TujuanKeluarOptions}" SelectedItem="{Binding FormTujuanKeluar}" Width="150" />
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding IsTujuanProduksi}">
                <TextBlock Text="Untuk Produksi Barang" FontSize="11" Foreground="#6B7280" />
                <ComboBox ItemsSource="{Binding ProduksiOptions}" SelectedItem="{Binding FormProduksiTrans}" Width="220">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock>
                        <Run Text="{Binding IdBarangNavigation.NamaBarang}" />
                        <Run Text=" (" /><Run Text="{Binding TanggalInput}" /><Run Text=")" />
                      </TextBlock>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Jumlah" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormJumlah}" Width="90" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Harga Satuan" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormHargaSatuan}" Width="130" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Nilai (Total)" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormNilai}" Width="130" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Keterangan" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormKeterangan}" Width="200" />
              </StackPanel>

            </StackPanel>
          </WrapPanel>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Simpan" Command="{Binding AddTransCommand}"
                    Background="#16A34A" Foreground="White" BorderThickness="0" Padding="18,10" CornerRadius="8" />
            <Button Content="Batal" Command="{Binding ClearFormCommand}"
                    Background="Transparent" Foreground="#6B7280" BorderThickness="1" BorderBrush="#E5E7EB"
                    Padding="18,10" CornerRadius="8" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- RINCIAN HPP -->
      <Border Background="#EEF2FF" CornerRadius="14" Padding="20"
              IsVisible="{Binding LastHppBreakdown.Count}">
        <StackPanel Spacing="10">
          <TextBlock Text="Rincian HPP (diambil dari batch FIFO)" FontWeight="SemiBold" Foreground="#4F46E5" FontSize="14" />
          <ItemsControl ItemsSource="{Binding LastHppBreakdown}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="13" Foreground="#374151" Margin="0,3">
                  <Run Text="Batch #" /><Run Text="{Binding IdBatch}" />
                  <Run Text=" — " /><Run Text="{Binding JumlahDiambil}" /><Run Text=" unit × Rp " />
                  <Run Text="{Binding HargaPokokSatuan, StringFormat={}{0:N0}}" />
                  <Run Text=" = Rp " /><Run Text="{Binding SubtotalNilai, StringFormat={}{0:N0}}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Rectangle Height="1" Fill="#C7D2FE" Margin="0,4" />
          <TextBlock Text="{Binding LastHppTotal, StringFormat={}Total HPP: Rp {0:N0}}"
                     FontWeight="Bold" Foreground="#4F46E5" FontSize="15" />
        </StackPanel>
      </Border>

      <!-- AKSI HAPUS -->
      <Border Background="#FEF2F2" CornerRadius="14" Padding="18"
              IsVisible="{Binding IsRowSelected}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding SelectedTrans.IdTrans, StringFormat='Transaksi dipilih: {0}'}"
                     VerticalAlignment="Center" Foreground="#991B1B" FontSize="13.5" />
          <Button Grid.Column="1" Content="Hapus Transaksi Ini" Command="{Binding DeleteTransCommand}"
                  Background="#DC2626" Foreground="White" BorderThickness="0" Padding="16,8" CornerRadius="8" />
        </Grid>
      </Border>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- TABEL -->
      <Border Background="White" CornerRadius="14" Padding="22" BoxShadow="0 1 3 0 #0A000000">
        <StackPanel Spacing="14">

          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="⬆" FontSize="13" Foreground="#DC2626" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Daftar Barang Keluar" FontWeight="SemiBold" Foreground="#111827"
                       Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" Text="{Binding SearchText}" PlaceholderText="Cari nama barang..." Width="220" />
          </Grid>

          <Rectangle Height="1" Fill="#F3F4F6" />

          <DataGrid ItemsSource="{Binding TransList}" SelectedItem="{Binding SelectedTrans}"
                    AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                    IsReadOnly="True" MinHeight="350">
            <DataGrid.Styles>
              <Style Selector="DataGridCell TextBlock"><Setter Property="Foreground" Value="#111827" /></Style>
              <Style Selector="DataGridColumnHeader">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#6B7280" />
              </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTextColumn Header="No" Binding="{Binding No}" Width="65" />
              <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalTransaksi}" Width="110" />
              <DataGridTextColumn Header="Barang" Binding="{Binding IdBarangNavigation.NamaBarang}" Width="160" />
              <DataGridTextColumn Header="Tujuan" Binding="{Binding TujuanKeluar}" Width="120" />
              <DataGridTextColumn Header="Jml" Binding="{Binding Jumlah}" Width="65" />
              <DataGridTextColumn Header="Nilai" Binding="{Binding Nilai, StringFormat={}{0:N0}}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>