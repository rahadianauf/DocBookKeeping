<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DocBookKeeping.ViewModels"
             x:Class="DocBookKeeping.Views.BarangMasukView"
             x:DataType="vm:BarangMasukViewModel">
  <ScrollViewer>
    <StackPanel Spacing="24" Margin="0,0,0,24">

      <!-- HEADER -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="Barang Masuk" FontSize="30" FontWeight="Bold" Foreground="#111827" />
          <TextBlock Text="Catat pembelian atau hasil produksi barang" FontSize="14" Foreground="#6B7280" />
        </StackPanel>

        <Button Grid.Column="1" Content="＋  Tambah" Command="{Binding OpenAddFormCommand}"
                Padding="18,10" Margin="0,0,10,0" Background="#16A34A" Foreground="White"
                BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" />

        <Button Grid.Column="2" Content="⟳  Refresh" Command="{Binding LoadTransCommand}"
                Padding="18,10" Background="#4F46E5" Foreground="White"
                BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" />
      </Grid>

      <!-- KPI RINGKAS -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

        <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" BoxShadow="0 1 3 0 #0A000000">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="10" Background="#EEF2FF">
              <TextBlock Text="⬇" FontSize="16" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Jumlah Transaksi" FontSize="12.5" Foreground="#6B7280" />
              <TextBlock Text="{Binding JumlahTransaksi}" FontSize="21" FontWeight="Bold" Foreground="#111827" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="#4F46E5" CornerRadius="14" Padding="20">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="10" Background="#6366F1">
              <TextBlock Text="Rp" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Total Nilai Pembelian" FontSize="12.5" Foreground="#E0E7FF" />
              <TextBlock Text="{Binding TotalNilai, StringFormat={}Rp {0:N0}}" FontSize="21" FontWeight="Bold" Foreground="White" />
            </StackPanel>
          </Grid>
        </Border>

      </Grid>

      <!-- FORM TAMBAH/EDIT -->
      <Border Background="White" CornerRadius="14" Padding="22" BoxShadow="0 1 3 0 #0A000000"
              IsVisible="{Binding IsFormVisible}">
        <StackPanel Spacing="14">

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding FormModeLabel}" FontWeight="SemiBold" FontSize="15" Foreground="#111827" />
            <Button Grid.Column="1" Content="✕" Command="{Binding ClearFormCommand}"
                    Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="8,4" FontSize="14" />
          </Grid>

          <Rectangle Height="1" Fill="#F3F4F6" />

          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">

              <StackPanel Spacing="4">
                <TextBlock Text="Barang" FontSize="11" Foreground="#6B7280" />
                <ComboBox ItemsSource="{Binding BarangOptions}" SelectedItem="{Binding FormBarang}" Width="180">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding NamaBarang}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Sumber" FontSize="11" Foreground="#6B7280" />
                <ComboBox ItemsSource="{Binding SumberOptions}" SelectedItem="{Binding FormSumber}" Width="130" />
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding IsSumberBeli}">
                <TextBlock Text="Pemasok" FontSize="11" Foreground="#6B7280" />
                <ComboBox ItemsSource="{Binding PemasokOptions}" SelectedItem="{Binding FormPemasok}" Width="160">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding NamaPemasok}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

            </StackPanel>
          </WrapPanel>

          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">

              <StackPanel Spacing="4">
                <TextBlock Text="Jumlah" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormJumlah}" Width="90" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Harga Satuan" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormHargaSatuan}" Width="130" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Nilai (Total)" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormNilai}" Width="130" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Tanggal Kadaluwarsa (opsional)" FontSize="11" Foreground="#6B7280" />
                <DatePicker SelectedDate="{Binding FormTanggalKadaluwarsa}" Width="200" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Keterangan" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormKeterangan}" Width="200" />
              </StackPanel>

            </StackPanel>
          </WrapPanel>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Simpan" Command="{Binding AddTransCommand}"
                    Background="#16A34A" Foreground="White" BorderThickness="0" Padding="18,10" CornerRadius="8"
                    IsVisible="{Binding !IsEditMode}" />
            <Button Content="Simpan Perubahan" Command="{Binding UpdateTransCommand}"
                    Background="#4F46E5" Foreground="White" BorderThickness="0" Padding="18,10" CornerRadius="8"
                    IsVisible="{Binding IsEditMode}" />
            <Button Content="Hapus" Command="{Binding DeleteTransCommand}"
                    Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Padding="18,10" CornerRadius="8"
                    IsVisible="{Binding IsEditMode}" />
            <Button Content="Batal" Command="{Binding ClearFormCommand}"
                    Background="Transparent" Foreground="#6B7280" BorderThickness="1" BorderBrush="#E5E7EB"
                    Padding="18,10" CornerRadius="8" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- TABEL -->
      <Border Background="White" CornerRadius="14" Padding="22" BoxShadow="0 1 3 0 #0A000000">
        <StackPanel Spacing="14">

          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="⬇" FontSize="14" Foreground="#4F46E5" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Daftar Barang Masuk" FontWeight="SemiBold" Foreground="#111827"
                       Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" Text="{Binding SearchText}" PlaceholderText="Cari nama barang..." Width="220" />
          </Grid>

          <Rectangle Height="1" Fill="#F3F4F6" />

          <DataGrid ItemsSource="{Binding TransList}" SelectedItem="{Binding SelectedTrans}"
                    AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                    IsReadOnly="True" MinHeight="350">
            <DataGrid.Styles>
              <Style Selector="DataGridCell TextBlock"><Setter Property="Foreground" Value="#111827" /></Style>
              <Style Selector="DataGridColumnHeader">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#6B7280" />
              </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTextColumn Header="No" Binding="{Binding No}" Width="65" />
              <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalInput}" Width="110" />
              <DataGridTextColumn Header="Barang" Binding="{Binding IdBarangNavigation.NamaBarang}" Width="170" />
              <DataGridTextColumn Header="Sumber" Binding="{Binding Sumber}" Width="90" />
              <DataGridTextColumn Header="Pemasok" Binding="{Binding IdPemasokNavigation.NamaPemasok, TargetNullValue='-'}" Width="130" />
              <DataGridTextColumn Header="Jml" Binding="{Binding Jumlah}" Width="55" />
              <DataGridTextColumn Header="Nilai" Binding="{Binding Nilai, StringFormat={}{0:N0}}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>