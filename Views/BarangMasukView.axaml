<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DocBookKeeping.ViewModels"
             x:Class="DocBookKeeping.Views.BarangMasukView"
             x:DataType="vm:BarangMasukViewModel">
  <ScrollViewer>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="20" Margin="0,0,0,20">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="Barang Masuk" FontSize="28" FontWeight="Bold" Foreground="#111827" />
          <TextBlock Text="Catat pembelian atau hasil produksi barang" FontSize="13" Foreground="#6B7280" />
        </StackPanel>
        <Button Grid.Column="1" Content="+ Tambah" Command="{Binding OpenAddFormCommand}"
                Padding="18,10" Margin="0,0,10,0" Background="#16A34A" Foreground="White"
                BorderThickness="0" CornerRadius="6" />
        <Button Grid.Column="2" Content="Refresh" Command="{Binding LoadTransCommand}"
                Padding="18,10" Background="#4F46E5" Foreground="White"
                BorderThickness="0" CornerRadius="6" />
      </Grid>

      <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="8" IsVisible="{Binding IsFormVisible}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding FormModeLabel}" FontWeight="SemiBold" FontSize="13" Foreground="#4F46E5" />

          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
              <ComboBox PlaceholderText="Pilih Barang" ItemsSource="{Binding BarangOptions}"
                        SelectedItem="{Binding FormBarang}" Width="180">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding NamaBarang}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <ComboBox PlaceholderText="Sumber" ItemsSource="{Binding SumberOptions}"
                        SelectedItem="{Binding FormSumber}" Width="130" />

              <ComboBox PlaceholderText="Pemasok" ItemsSource="{Binding PemasokOptions}"
                        SelectedItem="{Binding FormPemasok}" Width="160"
                        IsVisible="{Binding IsSumberBeli}">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding NamaPemasok}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </WrapPanel>

          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
              <TextBox PlaceholderText="Jumlah" Text="{Binding FormJumlah}" Width="90" />
              <TextBox PlaceholderText="Harga Satuan" Text="{Binding FormHargaSatuan}" Width="130" />
              <TextBox PlaceholderText="Nilai (Total)" Text="{Binding FormNilai}" Width="130" />
              <StackPanel Spacing="4">
                <TextBlock Text="Tanggal Kadaluwarsa (opsional)" FontSize="11" Foreground="#6B7280" />
                <DatePicker SelectedDate="{Binding FormTanggalKadaluwarsa}" Width="200" />
              </StackPanel>
              <TextBox PlaceholderText="Keterangan" Text="{Binding FormKeterangan}" Width="200" />
            </StackPanel>
          </WrapPanel>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Simpan" Command="{Binding AddTransCommand}"
                    Background="#16A34A" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6"
                    IsVisible="{Binding !IsEditMode}" />
            <Button Content="Simpan Perubahan" Command="{Binding UpdateTransCommand}"
                    Background="#4F46E5" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6"
                    IsVisible="{Binding IsEditMode}" />
            <Button Content="Hapus" Command="{Binding DeleteTransCommand}"
                    Background="#DC2626" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6"
                    IsVisible="{Binding IsEditMode}" />
            <Button Content="Batal" Command="{Binding ClearFormCommand}"
                    Background="Transparent" Foreground="#6B7280" BorderThickness="1" Padding="15,10" CornerRadius="6" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- BIAYA TAMBAHAN (muncul kalau transaksi MASUK sudah dipilih/tersimpan) -->
      <Border Grid.Row="2" Background="#FFFBEB" Padding="15" CornerRadius="8"
              IsVisible="{Binding IsEditMode}">
        <StackPanel Spacing="10">
          <TextBlock Text="Biaya Tambahan (Ongkos Kirim, Bea Masuk, dll)"
                    FontWeight="SemiBold" FontSize="13" Foreground="#D97706" />

          <TextBlock Text="{Binding HargaBeliSaatIni, StringFormat='Harga Pokok per Unit saat ini: Rp {0:N0}'}"
                    FontSize="12" Foreground="#92400E" />

          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox PlaceholderText="Komponen (mis. Ongkos Kirim)" Text="{Binding BiayaKomponen}" Width="180" />
            <TextBox PlaceholderText="Nilai (Rp)" Text="{Binding BiayaNilai}" Width="120" />
            <TextBox PlaceholderText="Keterangan" Text="{Binding BiayaKeterangan}" Width="180" />
            <Button Content="Tambah Biaya" Command="{Binding AddBiayaCommand}"
                    Background="#D97706" Foreground="White" BorderThickness="0" Padding="12,8" CornerRadius="6" />
          </StackPanel>

          <DataGrid ItemsSource="{Binding BiayaList}" SelectedItem="{Binding SelectedBiaya}"
                    AutoGenerateColumns="False" GridLinesVisibility="Horizontal" IsReadOnly="True"
                    Height="150">
            <DataGrid.Styles>
              <Style Selector="DataGridCell TextBlock">
                <Setter Property="Foreground" Value="#111827" />
              </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Komponen" Binding="{Binding Komponen}" Width="*" />
              <DataGridTextColumn Header="Nilai" Binding="{Binding Nilai, StringFormat={}{0:N0}}" Width="120" />
              <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="180" />
            </DataGrid.Columns>
          </DataGrid>

          <Button Content="Hapus Biaya Terpilih" Command="{Binding DeleteBiayaCommand}"
                  Background="#DC2626" Foreground="White" BorderThickness="0" Padding="12,8" CornerRadius="6"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Background="White" Padding="15" CornerRadius="8">
        <TextBox PlaceholderText="Cari nama barang/pemasok..." Text="{Binding SearchText}" Width="300" HorizontalAlignment="Left" />
      </Border>

      <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />

      <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="15" MinHeight="400">
        <DataGrid ItemsSource="{Binding TransList}" SelectedItem="{Binding SelectedTrans}"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal" IsReadOnly="True" MinHeight="350">
          <DataGrid.Styles>
            <Style Selector="DataGridCell TextBlock"><Setter Property="Foreground" Value="#111827" /></Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTextColumn Header="No" Binding="{Binding No}" Width="40" />
            <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalInput}" Width="90" />
            <DataGridTextColumn Header="Barang" Binding="{Binding IdBarangNavigation.NamaBarang}" Width="150" />
            <DataGridTextColumn Header="Sumber" Binding="{Binding Sumber}" Width="90" />
            <DataGridTextColumn Header="Pemasok" Binding="{Binding IdPemasokNavigation.NamaPemasok, TargetNullValue='-'}" Width="130" />
            <DataGridTextColumn Header="Jml" Binding="{Binding Jumlah}" Width="45" />
            <DataGridTextColumn Header="Nilai" Binding="{Binding Nilai, StringFormat={}{0:N0}}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

    </Grid>
  </ScrollViewer>
</UserControl>
