<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DocBookKeeping.ViewModels"
             x:Class="DocBookKeeping.Views.JasaView"
             x:DataType="vm:JasaViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="20">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="5">
        <TextBlock Text="Jasa" FontSize="28" FontWeight="Bold" Foreground="#111827" />
        <TextBlock Text="Kelola data jasa/layanan" FontSize="13" Foreground="#6B7280" />
      </StackPanel>
      <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadJasaCommand}"
              Padding="18,10" Background="#4F46E5" Foreground="White"
              BorderThickness="0" CornerRadius="6" HorizontalAlignment="Right"/>
    </Grid>

    <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="8">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding FormModeLabel}" FontWeight="SemiBold" FontSize="13" Foreground="#4F46E5" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBox PlaceholderText="Nama Jasa" Text="{Binding FormNamaJasa}" Width="220" />

          <ComboBox PlaceholderText="Pilih Kategori"
                    ItemsSource="{Binding KategoriOptions}"
                    SelectedItem="{Binding FormKategori}"
                    Width="200">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Kategori}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Button Content="Tambah" Command="{Binding AddJasaCommand}"
                  Background="#16A34A" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6" />
          <Button Content="Simpan Perubahan" Command="{Binding UpdateJasaCommand}"
                  Background="#4F46E5" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6" />
          <Button Content="Hapus" Command="{Binding DeleteJasaCommand}"
                  Background="#DC2626" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6" />
          <Button Content="Batal" Command="{Binding ClearFormCommand}"
                  Background="Transparent" Foreground="#6B7280" BorderThickness="1" Padding="15,10" CornerRadius="6" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="White" Padding="15" CornerRadius="8">
      <TextBox PlaceholderText="Cari nama jasa..." Text="{Binding SearchText}" Width="300" HorizontalAlignment="Left" />
    </Border>

    <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />

    <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="15" MinHeight="400">
      <DataGrid ItemsSource="{Binding JasaList}" SelectedItem="{Binding SelectedJasa}"
                AutoGenerateColumns="False" GridLinesVisibility="Horizontal" IsReadOnly="True" MinHeight="350">
        <DataGrid.Styles>
          <Style Selector="DataGridCell TextBlock">
            <Setter Property="Foreground" Value="#111827" />
          </Style>
        </DataGrid.Styles>
        <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding IdJasa}" Width="80" />
          <DataGridTextColumn Header="Nama Jasa" Binding="{Binding NamaJasa}" Width="*" />
          <DataGridTextColumn Header="Kategori" Binding="{Binding IdKategoriNavigation.Kategori}" Width="200" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

  </Grid>
</UserControl>