<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DocBookKeeping.ViewModels"
             x:Class="DocBookKeeping.Views.PasienView"
             x:DataType="vm:PasienViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="20">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="5">
        <TextBlock Text="Pasien" FontSize="28" FontWeight="Bold" Foreground="#111827" />
        <TextBlock Text="Kelola data pasien" FontSize="13" Foreground="#6B7280" />
      </StackPanel>
      <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadPasienCommand}"
              Padding="18,10" Background="#4F46E5" Foreground="White"
              BorderThickness="0" CornerRadius="6" HorizontalAlignment="Right"/>
    </Grid>

    <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="8">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding FormModeLabel}" FontWeight="SemiBold" FontSize="13" Foreground="#4F46E5" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBox PlaceholderText="Nama Pasien" Text="{Binding FormNamaPasien}" Width="200" />
          <TextBox PlaceholderText="No. Telepon" Text="{Binding FormNoTelepon}" Width="160" />
          <TextBox PlaceholderText="Alamat" Text="{Binding FormAlamat}" Width="260" />

          <Button Content="Tambah" Command="{Binding AddPasienCommand}"
                  Background="#16A34A" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6" />
          <Button Content="Simpan Perubahan" Command="{Binding UpdatePasienCommand}"
                  Background="#4F46E5" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6" />
          <Button Content="Hapus" Command="{Binding DeletePasienCommand}"
                  Background="#DC2626" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6" />
          <Button Content="Batal" Command="{Binding ClearFormCommand}"
                  Background="Transparent" Foreground="#6B7280" BorderThickness="1" Padding="15,10" CornerRadius="6" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="White" Padding="15" CornerRadius="8">
      <TextBox PlaceholderText="Cari nama pasien..." Text="{Binding SearchText}" Width="300" HorizontalAlignment="Left" />
    </Border>

    <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />

    <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="15" MinHeight="400">
      <DataGrid ItemsSource="{Binding PasienList}" SelectedItem="{Binding SelectedPasien}"
                AutoGenerateColumns="False" GridLinesVisibility="Horizontal" IsReadOnly="True" MinHeight="350">
        <DataGrid.Styles>
          <Style Selector="DataGridCell TextBlock">
            <Setter Property="Foreground" Value="#111827" />
          </Style>
        </DataGrid.Styles>
        <DataGrid.Columns>
          <DataGridTextColumn Header="No" Binding="{Binding No}" Width="60" />
          <DataGridTextColumn Header="Nama Pasien" Binding="{Binding NamaPasien}" Width="*" />
          <DataGridTextColumn Header="No. Telepon" Binding="{Binding NoTelepon}" Width="150" />
          <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="250" />
          <DataGridTextColumn Header="Tanggal Daftar" Binding="{Binding TanggalDaftar}" Width="150" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

  </Grid>
</UserControl>