<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DocBookKeeping.ViewModels"
             x:Class="DocBookKeeping.Views.TransJasaView"
             x:DataType="vm:TransJasaViewModel">
  <ScrollViewer>
    <StackPanel Spacing="24" Margin="0,0,0,24">

      <!-- HEADER -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="Transaksi Jasa" FontSize="30" FontWeight="Bold" Foreground="#111827" />
          <TextBlock Text="Catat layanan yang diberikan ke pasien" FontSize="14" Foreground="#6B7280" />
        </StackPanel>

        <Button Grid.Column="1" Content="＋  Tambah Transaksi" Command="{Binding OpenAddFormCommand}"
                Padding="18,10" Margin="0,0,10,0" Background="#16A34A" Foreground="White"
                BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" />

        <Button Grid.Column="2" Content="⟳  Refresh" Command="{Binding LoadTransCommand}"
                Padding="18,10" Background="#4F46E5" Foreground="White"
                BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" />
      </Grid>

      <!-- KPI RINGKAS -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

        <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" BoxShadow="0 1 3 0 #0A000000">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="10" Background="#DCFCE7">
              <TextBlock Text="↗" FontSize="17" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Jumlah Transaksi" FontSize="12.5" Foreground="#6B7280" />
              <TextBlock Text="{Binding JumlahTransaksi}" FontSize="21" FontWeight="Bold" Foreground="#111827" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="#16A34A" CornerRadius="14" Padding="20">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="10" Background="#22C55E">
              <TextBlock Text="Rp" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Total Pendapatan" FontSize="12.5" Foreground="#DCFCE7" />
              <TextBlock Text="{Binding TotalPendapatan, StringFormat={}Rp {0:N0}}" FontSize="21" FontWeight="Bold" Foreground="White" />
            </StackPanel>
          </Grid>
        </Border>

      </Grid>

      <!-- FORM TAMBAH/EDIT -->
      <Border Background="White" CornerRadius="14" Padding="22" BoxShadow="0 1 3 0 #0A000000"
              IsVisible="{Binding IsFormVisible}">
        <StackPanel Spacing="14">

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding FormModeLabel}" FontWeight="SemiBold" FontSize="15" Foreground="#111827" />
            <Button Grid.Column="1" Content="✕" Command="{Binding ClearFormCommand}"
                    Background="Transparent" Foreground="#9CA3AF" BorderThickness="0"
                    Padding="8,4" FontSize="14" />
          </Grid>

          <Rectangle Height="1" Fill="#F3F4F6" />

          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">

              <StackPanel Spacing="4">
                <TextBlock Text="Pasien (opsional)" FontSize="11" Foreground="#6B7280" />
                <ComboBox ItemsSource="{Binding PasienOptions}" SelectedItem="{Binding FormPasien}" Width="180">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding NamaPasien}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Jasa" FontSize="11" Foreground="#6B7280" />
                <ComboBox ItemsSource="{Binding JasaOptions}" SelectedItem="{Binding FormJasa}" Width="180">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding NamaJasa}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Harga (Rp)" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormHarga}" Width="130" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Keterangan" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormKeterangan}" Width="180" />
              </StackPanel>

              <!--<StackPanel Spacing="4">
                <TextBlock Text="Tag" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormTag}" Width="120" />
              </StackPanel>
              -->
            </StackPanel>
          </WrapPanel>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Simpan" Command="{Binding AddTransCommand}"
                    Background="#16A34A" Foreground="White" BorderThickness="0" Padding="18,10" CornerRadius="8"
                    IsVisible="{Binding !IsEditMode}" />
            <Button Content="Simpan Perubahan" Command="{Binding UpdateTransCommand}"
                    Background="#4F46E5" Foreground="White" BorderThickness="0" Padding="18,10" CornerRadius="8"
                    IsVisible="{Binding IsEditMode}" />
            <Button Content="Hapus" Command="{Binding DeleteTransCommand}"
                    Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Padding="18,10" CornerRadius="8"
                    IsVisible="{Binding IsEditMode}" />
            <Button Content="Batal" Command="{Binding ClearFormCommand}"
                    Background="Transparent" Foreground="#6B7280" BorderThickness="1" BorderBrush="#E5E7EB"
                    Padding="18,10" CornerRadius="8" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- TABEL -->
      <Border Background="White" CornerRadius="14" Padding="22" BoxShadow="0 1 3 0 #0A000000">
        <StackPanel Spacing="14">

          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="↗" FontSize="15" Foreground="#16A34A" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Daftar Transaksi" FontWeight="SemiBold" Foreground="#111827"
                       Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" Text="{Binding SearchText}" PlaceholderText="Cari pasien/jasa..." Width="220" />
          </Grid>

          <Rectangle Height="1" Fill="#F3F4F6" />

          <DataGrid ItemsSource="{Binding TransList}" SelectedItem="{Binding SelectedTrans}"
                    AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                    IsReadOnly="True" MinHeight="350">
            <DataGrid.Styles>
              <Style Selector="DataGridCell TextBlock">
                <Setter Property="Foreground" Value="#111827" />
              </Style>
              <Style Selector="DataGridColumnHeader">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#6B7280" />
              </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTextColumn Header="No" Binding="{Binding No}" Width="65" />
              <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalInput}" Width="110" />
              <DataGridTextColumn Header="Pasien" Binding="{Binding IdPasienNavigation.NamaPasien, TargetNullValue='- Umum -'}" Width="170" />
              <DataGridTextColumn Header="Jasa" Binding="{Binding IdJasaNavigation.NamaJasa}" Width="170" />
              <DataGridTextColumn Header="Harga" Binding="{Binding Harga, StringFormat={}{0:N0}}" Width="120" />
              <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="180" />
              <!-- <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="90" /> -->
            </DataGrid.Columns>
          </DataGrid>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>