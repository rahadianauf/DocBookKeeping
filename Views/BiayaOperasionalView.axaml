<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DocBookKeeping.ViewModels"
             x:Class="DocBookKeeping.Views.BiayaOperasionalView"
             x:DataType="vm:BiayaOperasionalViewModel">
  <ScrollViewer>
    <StackPanel Spacing="24" Margin="0,0,0,24">

      <!-- HEADER -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="Biaya Operasional" FontSize="30" FontWeight="Bold" Foreground="#111827" />
          <TextBlock Text="Gaji, sewa, listrik, dan biaya rutin lainnya" FontSize="14" Foreground="#6B7280" />
        </StackPanel>

        <Button Grid.Column="1" Content="＋  Tambah" Command="{Binding OpenAddFormCommand}"
                Padding="18,10" Margin="0,0,10,0" Background="#16A34A" Foreground="White"
                BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" />

        <Button Grid.Column="2" Content="⟳  Refresh" Command="{Binding LoadBiayaCommand}"
                Padding="18,10" Background="#4F46E5" Foreground="White"
                BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" />
      </Grid>

      <!-- KPI RINGKAS -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

        <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" BoxShadow="0 1 3 0 #0A000000">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="10" Background="#FEF3C7">
              <TextBlock Text="⊖" FontSize="16" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Jumlah Entri" FontSize="12.5" Foreground="#6B7280" />
              <TextBlock Text="{Binding JumlahEntri}" FontSize="21" FontWeight="Bold" Foreground="#111827" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="#DC2626" CornerRadius="14" Padding="20">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="10" Background="#EF4444">
              <TextBlock Text="Rp" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Total Biaya Bulan Ini" FontSize="12.5" Foreground="#FEE2E2" />
              <TextBlock Text="{Binding TotalBiayaBulanIni, StringFormat={}Rp {0:N0}}" FontSize="21" FontWeight="Bold" Foreground="White" />
            </StackPanel>
          </Grid>
        </Border>

      </Grid>

      <!-- FORM TAMBAH/EDIT -->
      <Border Background="White" CornerRadius="14" Padding="22" BoxShadow="0 1 3 0 #0A000000"
              IsVisible="{Binding IsFormVisible}">
        <StackPanel Spacing="14">

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding FormModeLabel}" FontWeight="SemiBold" FontSize="15" Foreground="#111827" />
            <Button Grid.Column="1" Content="✕" Command="{Binding ClearFormCommand}"
                    Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="8,4" FontSize="14" />
          </Grid>

          <Rectangle Height="1" Fill="#F3F4F6" />

          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">

              <StackPanel Spacing="4">
                <TextBlock Text="Kategori" FontSize="11" Foreground="#6B7280" />
                <ComboBox ItemsSource="{Binding KategoriOptions}" SelectedItem="{Binding FormKategori}" Width="150" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Nominal (Rp)" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormNominal}" Width="130" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Tanggal" FontSize="11" Foreground="#6B7280" />
                <DatePicker SelectedDate="{Binding FormTanggal}" Width="160" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Keterangan" FontSize="11" Foreground="#6B7280" />
                <TextBox Text="{Binding FormKeterangan}" Width="220" />
              </StackPanel>

            </StackPanel>
          </WrapPanel>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Simpan" Command="{Binding AddBiayaCommand}"
                    Background="#16A34A" Foreground="White" BorderThickness="0" Padding="18,10" CornerRadius="8"
                    IsVisible="{Binding !IsEditMode}" />
            <Button Content="Simpan Perubahan" Command="{Binding UpdateBiayaCommand}"
                    Background="#4F46E5" Foreground="White" BorderThickness="0" Padding="18,10" CornerRadius="8"
                    IsVisible="{Binding IsEditMode}" />
            <Button Content="Hapus" Command="{Binding DeleteBiayaCommand}"
                    Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Padding="18,10" CornerRadius="8"
                    IsVisible="{Binding IsEditMode}" />
            <Button Content="Batal" Command="{Binding ClearFormCommand}"
                    Background="Transparent" Foreground="#6B7280" BorderThickness="1" BorderBrush="#E5E7EB"
                    Padding="18,10" CornerRadius="8" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- TABEL -->
      <Border Background="White" CornerRadius="14" Padding="22" BoxShadow="0 1 3 0 #0A000000">
        <StackPanel Spacing="14">

          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="⊖" FontSize="14" Foreground="#D97706" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Daftar Biaya" FontWeight="SemiBold" Foreground="#111827"
                       Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" Text="{Binding SearchText}" PlaceholderText="Cari kategori..." Width="220" />
          </Grid>

          <Rectangle Height="1" Fill="#F3F4F6" />

          <DataGrid ItemsSource="{Binding BiayaList}" SelectedItem="{Binding SelectedBiaya}"
                    AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                    IsReadOnly="True" MinHeight="350">
            <DataGrid.Styles>
              <Style Selector="DataGridCell TextBlock"><Setter Property="Foreground" Value="#111827" /></Style>
              <Style Selector="DataGridColumnHeader">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#6B7280" />
              </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal}" Width="100" />
              <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="150" />
              <DataGridTextColumn Header="Nominal" Binding="{Binding Nominal, StringFormat={}{0:N0}}" Width="130" />
              <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>