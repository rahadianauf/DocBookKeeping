<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DocBookKeeping.ViewModels"
             x:Class="DocBookKeeping.Views.BiayaOperasionalView"
             x:DataType="vm:BiayaOperasionalViewModel">
  <ScrollViewer>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="20" Margin="0,0,0,20">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="Biaya Operasional" FontSize="28" FontWeight="Bold" Foreground="#111827" />
          <TextBlock Text="Gaji, sewa, listrik, dan biaya rutin lainnya" FontSize="13" Foreground="#6B7280" />
        </StackPanel>
        <Button Grid.Column="1" Content="+ Tambah" Command="{Binding OpenAddFormCommand}"
                Padding="18,10" Margin="0,0,10,0" Background="#16A34A" Foreground="White"
                BorderThickness="0" CornerRadius="6" />
        <Button Grid.Column="2" Content="Refresh" Command="{Binding LoadBiayaCommand}"
                Padding="18,10" Background="#4F46E5" Foreground="White"
                BorderThickness="0" CornerRadius="6" />
      </Grid>

      <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
        <StackPanel Spacing="8">
          <TextBlock Text="Total Biaya Bulan Ini" FontSize="13" Foreground="#6B7280" />
          <TextBlock Text="{Binding TotalBiayaBulanIni, StringFormat={}Rp {0:N0}}"
                     FontSize="24" FontWeight="Bold" Foreground="#DC2626" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Background="White" Padding="15" CornerRadius="8" IsVisible="{Binding IsFormVisible}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding FormModeLabel}" FontWeight="SemiBold" FontSize="13" Foreground="#4F46E5" />

          <StackPanel Orientation="Horizontal" Spacing="10">
            <ComboBox PlaceholderText="Kategori" ItemsSource="{Binding KategoriOptions}"
                      SelectedItem="{Binding FormKategori}" Width="150" />
            <TextBox PlaceholderText="Nominal (Rp)" Text="{Binding FormNominal}" Width="130" />
            <DatePicker SelectedDate="{Binding FormTanggal}" Width="160" />
            <TextBox PlaceholderText="Keterangan" Text="{Binding FormKeterangan}" Width="220" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Simpan" Command="{Binding AddBiayaCommand}"
                    Background="#16A34A" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6"
                    IsVisible="{Binding !IsEditMode}" />
            <Button Content="Simpan Perubahan" Command="{Binding UpdateBiayaCommand}"
                    Background="#4F46E5" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6"
                    IsVisible="{Binding IsEditMode}" />
            <Button Content="Hapus" Command="{Binding DeleteBiayaCommand}"
                    Background="#DC2626" Foreground="White" BorderThickness="0" Padding="15,10" CornerRadius="6"
                    IsVisible="{Binding IsEditMode}" />
            <Button Content="Batal" Command="{Binding ClearFormCommand}"
                    Background="Transparent" Foreground="#6B7280" BorderThickness="1" Padding="15,10" CornerRadius="6" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Background="White" Padding="15" CornerRadius="8">
        <TextBox PlaceholderText="Cari kategori..." Text="{Binding SearchText}" Width="300" HorizontalAlignment="Left" />
      </Border>

      <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />

      <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="15" MinHeight="400">
        <DataGrid ItemsSource="{Binding BiayaList}" SelectedItem="{Binding SelectedBiaya}"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal" IsReadOnly="True" MinHeight="350">
          <DataGrid.Styles>
            <Style Selector="DataGridCell TextBlock"><Setter Property="Foreground" Value="#111827" /></Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal}" Width="100" />
            <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="150" />
            <DataGridTextColumn Header="Nominal" Binding="{Binding Nominal, StringFormat={}{0:N0}}" Width="120" />
            <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

    </Grid>
  </ScrollViewer>
</UserControl>