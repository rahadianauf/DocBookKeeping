<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DocBookKeeping.ViewModels"
             x:Class="DocBookKeeping.Views.StokView"
             x:DataType="vm:StokViewModel">
  <ScrollViewer>
    <StackPanel Spacing="24" Margin="0,0,0,24">

      <!-- HEADER -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="Stok Barang" FontSize="30" FontWeight="Bold" Foreground="#111827" />
          <TextBlock Text="Sisa stok tiap barang saat ini (berdasarkan FIFO)" FontSize="14" Foreground="#6B7280" />
        </StackPanel>
        <Button Grid.Column="1" Content="⟳  Refresh" Command="{Binding LoadStokCommand}"
                Padding="18,10" Background="#4F46E5" Foreground="White"
                BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" />
      </Grid>

      <!-- KPI RINGKAS -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

        <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" BoxShadow="0 1 3 0 #0A000000">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="10" Background="#EEF2FF">
              <TextBlock Text="▦" FontSize="16" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Jenis Barang" FontSize="12.5" Foreground="#6B7280" />
              <TextBlock Text="{Binding JumlahJenisBarang}" FontSize="21" FontWeight="Bold" Foreground="#111827" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="#4F46E5" CornerRadius="14" Padding="20">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="10" Background="#6366F1">
              <TextBlock Text="Rp" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Total Nilai Persediaan" FontSize="12.5" Foreground="#E0E7FF" />
              <TextBlock Text="{Binding TotalNilaiPersediaan, StringFormat={}Rp {0:N0}}" FontSize="21" FontWeight="Bold" Foreground="White" />
            </StackPanel>
          </Grid>
        </Border>

      </Grid>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- TABEL -->
      <Border Background="White" CornerRadius="14" Padding="22" BoxShadow="0 1 3 0 #0A000000">
        <StackPanel Spacing="14">

          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="▦" FontSize="15" Foreground="#4F46E5" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Daftar Stok" FontWeight="SemiBold" Foreground="#111827"
                       Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" Text="{Binding SearchText}" PlaceholderText="Cari nama barang..." Width="220" />
          </Grid>

          <Rectangle Height="1" Fill="#F3F4F6" />

          <DataGrid ItemsSource="{Binding StokList}"
                    AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                    IsReadOnly="True" MinHeight="380">
            <DataGrid.Styles>
              <Style Selector="DataGridCell TextBlock"><Setter Property="Foreground" Value="#111827" /></Style>
              <Style Selector="DataGridColumnHeader">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#6B7280" />
              </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Barang" Binding="{Binding NamaBarang}" Width="*" />
              <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori, TargetNullValue='-'}" Width="150" />
              <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan, TargetNullValue='-'}" Width="100" />
              <DataGridTextColumn Header="Stok Saat Ini" Binding="{Binding TotalStok}" Width="120" />
              <DataGridTextColumn Header="Nilai Persediaan" Binding="{Binding NilaiPersediaan, StringFormat={}{0:N0}}" Width="150" />
            </DataGrid.Columns>
          </DataGrid>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>